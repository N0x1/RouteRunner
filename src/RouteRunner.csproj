<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RouteRunner</AssemblyName>
    <Version>1.3.5</Version>
    <Title>Route Runner</Title>
    <Product>Route Runner</Product>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\STRAFTAT</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(MSBuildThisFileDirectory)..\reference\BepInEx</BepInExDir>
    <ModMenuDir Condition="'$(ModMenuDir)' == ''">$(MSBuildThisFileDirectory)..\reference\ModMenu</ModMenuDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Core\*.cs" />
    <Reference Include="$(GameDir)\STRAFTAT_Data\Managed\*.dll" Exclude="$(GameDir)\STRAFTAT_Data\Managed\System*.dll;$(GameDir)\STRAFTAT_Data\Managed\mscorlib.dll;$(GameDir)\STRAFTAT_Data\Managed\netstandard.dll;$(GameDir)\STRAFTAT_Data\Managed\Mono*.dll"><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ModMenu"><HintPath>$(ModMenuDir)\ModMenu.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)\STRAFTAT_Data\Managed\Assembly-CSharp.dll')" Text="Set GameDir to your STRAFTAT installation." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')" Text="Set BepInExDir to a BepInEx 5 folder." />
    <Error Condition="!Exists('$(ModMenuDir)\ModMenu.dll')" Text="Set ModMenuDir to the Mod Menu 1.2.0 reference DLL folder (development only)." />
  </Target>
</Project>
